{
  "rewrites": [
    {
      "source": "/tb/:path*",
      "destination": "https://tankbuch-jet.vercel.app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tankbuch-jet.vercel.app/api/:path*"
    },
    {
      "source": "/km/:path*",
      "destination": "https://karteikarten-manager.vercel.app/:path*"
    }
  ]
}
