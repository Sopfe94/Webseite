---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  showBackHome?: boolean;
  lpNav?: boolean;
  activePath?: string;
}

const { title, description, showBackHome = true, lpNav = false, activePath = '' } = Astro.props;

const lpLinks = [
  { href: '/lp', label: 'Übersicht' },
  { href: '/lp/funktionen', label: 'Funktionen' },
  { href: '/lp/screenshots', label: 'Screenshots' },
  { href: '/lp/preise', label: 'Preise' },
  { href: '/lp/faq', label: 'FAQ' },
  { href: '/lp/mission', label: 'Mission' },
  { href: '/lp/kontakt', label: 'Kontakt' },
];
---
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <!-- ── Site gate: run before paint to avoid content flash ── -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('ga_site_unlocked') === '1') {
            document.documentElement.classList.add('gate-unlocked');
          }
        } catch (e) {}
      })();
    </script>
    <style>
      html:not(.gate-unlocked) body > *:not(#site-gate-overlay) {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <div id="site-gate-overlay" class="site-gate-overlay">
      <div class="site-gate-box">
        <p class="eyebrow">GROSS APPS</p>
        <h1 class="site-gate-title">Die Webseite ist im Aufbau.</h1>
        <p class="site-gate-sub">Bitte Code eingeben, um fortzufahren.</p>
        <input type="password" id="site-gate-input" class="site-gate-input" placeholder="Code" autocomplete="off" inputmode="numeric" />
        <button class="btn btn-primary btn-lg site-gate-btn" id="site-gate-btn">Entsperren</button>
        <p class="site-gate-error" id="site-gate-error"></p>
      </div>
    </div>

    <script is:inline>
      (function () {
        var CODE_HASH = 'b87a5db8584719141703f18d472cb63faff0e196afaa8fc1eaaa142652cfe37b';
        async function sha256(text) {
          var data = new TextEncoder().encode(text);
          var digest = await crypto.subtle.digest('SHA-256', data);
          return Array.from(new Uint8Array(digest)).map(function (b) {
            return b.toString(16).padStart(2, '0');
          }).join('');
        }
        async function unlock() {
          var input = document.getElementById('site-gate-input');
          var error = document.getElementById('site-gate-error');
          var hash = await sha256(input.value);
          if (hash === CODE_HASH) {
            try { localStorage.setItem('ga_site_unlocked', '1'); } catch (e) {}
            document.documentElement.classList.add('gate-unlocked');
            error.textContent = '';
          } else {
            error.textContent = 'Falscher Code.';
            input.value = '';
            input.focus();
          }
        }
        document.addEventListener('DOMContentLoaded', function () {
          var btn = document.getElementById('site-gate-btn');
          var input = document.getElementById('site-gate-input');
          if (btn) btn.addEventListener('click', unlock);
          if (input) input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') unlock();
          });
        });
      })();
    </script>

    <div class="glow-field"></div>

    {showBackHome && (
      <header class="site-header">
        <div class="container site-header-inner">
          <a class="back-home" href="/">
            <span aria-hidden="true">←</span> Alle Apps
          </a>
          {lpNav && (
            <div class="site-header-right">
              <nav class="site-nav" id="site-nav" aria-label="Lernpuls Unterseiten">
                {lpLinks.map((link) => (
                  <a href={link.href} aria-current={activePath === link.href ? 'page' : undefined}>{link.label}</a>
                ))}
              </nav>
              <a class="btn btn-outline btn-sm site-header-login" href="/lernpuls">Login</a>
              <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
                <span></span>
                <span></span>
                <span></span>
              </button>
            </div>
          )}
        </div>
      </header>
    )}
    <script is:inline>
      (function () {
        document.addEventListener('DOMContentLoaded', function () {
          var header = document.querySelector('.site-header');
          var toggle = document.getElementById('nav-toggle');
          if (!header || !toggle) return;
          toggle.addEventListener('click', function () {
            var open = header.classList.toggle('nav-open');
            toggle.setAttribute('aria-expanded', String(open));
            toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && header.classList.contains('nav-open')) {
              header.classList.remove('nav-open');
              toggle.setAttribute('aria-expanded', 'false');
              toggle.setAttribute('aria-label', 'Menü öffnen');
            }
          });
        });
      })();
    </script>
        </div>
      </header>
    )}

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <span>© 2026 Groß Apps</span>
        <nav>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
