---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Preise – Lernpuls"
  description="Lernpuls Preise: Kostenlos nutzbar, Pro-Version ab September 2026."
  lpNav
  activePath="/lp/preise"
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">PREISE</p>
      <h1>Kostenlos starten. <span class="accent">Pro folgt.</span></h1>
    </header>

    <section class="plans">
      <div class="card plan">
        <span class="badge">Verfügbar</span>
        <h2>Kostenlos</h2>
        <p class="price">0&nbsp;€</p>
        <ul>
          <li>Karteikarten-Verwaltung</li>
          <li>Arbeiten &amp; Lernempfehlungen</li>
          <li>Learnspace (Lerngruppen, Chat)</li>
        </ul>
        <a class="btn btn-primary btn-lg" href="/lernpuls">Jetzt loslegen</a>
      </div>

      <div class="card plan plan-pro">
        <span class="badge">Ab September 2026</span>
        <h2>Lernpuls <span class="grad">Pro</span></h2>
        <p class="price">Preis folgt</p>
        <p class="pro-note">
          Die genauen Pro-Funktionen stehen noch nicht final fest – sie werden hier ergänzt,
          sobald es so weit ist.
        </p>
        <a class="btn btn-outline btn-lg" href="/lp/kontakt">Frag mich danach</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head { position: relative; z-index: 1; padding: var(--space-10) 0 var(--space-8); max-width: 50ch; }
  .page-head h1 { font-size: clamp(28px, 4vw, var(--text-3xl)); margin-top: var(--space-3); }

  .plans {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    padding-bottom: var(--space-16);
    max-width: 760px;
  }
  .plan { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  .plan h2 { font-size: var(--text-xl); margin-top: var(--space-2); }
  .plan .price { font-size: var(--text-3xl); font-weight: var(--fw-semibold); margin: 0; }
  .plan ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .plan li {
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-left: var(--space-5);
    position: relative;
  }
  .plan li::before {
    content: '';
    position: absolute;
    left: 0; top: 8px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gradient-brand);
  }
  .plan-pro { opacity: 0.85; border-color: rgba(124, 58, 237, 0.35); }
  .pro-note { font-size: var(--text-sm); color: var(--text-muted); line-height: var(--lh-relaxed); }
  .plan .btn { margin-top: auto; }
</style>
