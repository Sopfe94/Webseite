---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Groß Apps"
  description="Groß Apps entwickelt Apps mit Leidenschaft und technischer Präzision. Kostenlos oder pro."
  showBackHome={false}
>
  <div class="container">
    <header class="hero">
      <p class="eyebrow">GROSS APPS</p>
      <h1>Wähle deine <span class="accent">App.</span></h1>
      <p class="lede">Von hier aus geht's direkt in das Tool, das du gerade brauchst.</p>
    </header>

    <div class="grid">
      <a class="card card-hover-glow app-card" href="/tb" aria-label="Tankbuch öffnen">
        <div class="medallion">
          <svg viewBox="0 0 24 24" fill="none">
            <defs>
              <linearGradient id="g-tank" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7C3AED"/>
                <stop offset="1" stop-color="#06B6D4"/>
              </linearGradient>
            </defs>
            <path d="M4 20V9.5L12 4l8 5.5V20a1 1 0 01-1 1h-3v-6a2 2 0 00-4 0v6H5a1 1 0 01-1-1z" fill="url(#g-tank)"/>
            <rect x="14.5" y="10" width="4" height="6" rx="1" fill="#0D0A1A"/>
          </svg>
        </div>
        <p class="wordmark app-name">Tank<span class="grad">buch</span></p>
        <p class="tagline">Kostenverwaltung und Preisvergleich für deine Tankstopps.</p>
        <span class="btn btn-primary btn-lg cta">
          App öffnen
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>

      <a class="card card-hover-glow app-card" href="/lp" aria-label="Lernpuls öffnen">
        <div class="medallion medallion-icon">
          <img src="/images/lernpuls-icon.png" alt="" width="56" height="56" />
        </div>
        <p class="wordmark app-name">Lern<span class="grad">puls</span></p>
        <p class="tagline">All-in-One Lernplattform für deine Karteikarten.</p>
        <span class="btn btn-primary btn-lg cta">
          App öffnen
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </a>

      <div class="card app-card is-soon" aria-label="Pflanzen-App, bald verfügbar">
        <div class="medallion">
          <svg viewBox="0 0 24 24" fill="none">
            <defs>
              <linearGradient id="g-plant" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7C3AED"/>
                <stop offset="1" stop-color="#06B6D4"/>
              </linearGradient>
            </defs>
            <path d="M12 21V11" stroke="url(#g-plant)" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M12 12c0-4 3-7 7-7 0 4-3 7-7 7z" fill="url(#g-plant)"/>
            <path d="M12 15c0-3.3-2.5-6-6-6 0 3.3 2.5 6 6 6z" fill="url(#g-plant)"/>
          </svg>
        </div>
        <p class="wordmark app-name">Pflanzen<span class="grad">App</span></p>
        <p class="tagline">Pflanzendokumentation mit KI. Aktuell in Planung.</p>
        <span class="badge">Bald verfügbar</span>
        <button class="btn btn-primary btn-lg cta" disabled>Bald verfügbar</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-16) 0;
    position: relative;
    z-index: 1;
  }
  .hero .eyebrow { margin: 0 0 var(--space-5); }
  .hero h1 {
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.05;
    margin: 0 0 var(--space-4);
  }
  .hero .lede {
    font-size: var(--text-md);
    color: var(--text-muted);
    max-width: 46ch;
    margin: 0 auto;
    line-height: var(--lh-normal);
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    padding-bottom: var(--space-16);
  }

  .app-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
  }
  .app-card.is-soon { opacity: 0.55; }

  .medallion {
    width: 56px; height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-midnight-mid);
    border: 1px solid rgba(124, 58, 237, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .medallion svg { width: 28px; height: 28px; }
  .medallion-icon { padding: 0; overflow: hidden; }
  .medallion-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .app-name { font-size: var(--text-xl); margin: 0; }

  .tagline {
    font-size: var(--text-sm);
    line-height: var(--lh-normal);
    color: var(--text-muted);
    flex: 1;
  }

  .cta svg { width: 16px; height: 16px; }
</style>
